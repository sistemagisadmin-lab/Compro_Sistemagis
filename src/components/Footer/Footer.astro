---
import SistemagisLogo from '../Navbar/SistemagisLogo.astro';

const currentYear = new Date().getFullYear();
---

<footer class="w-full bg-[#0b1120] text-slate-400 py-16 px-6 sm:px-10 lg:px-12 border-t border-slate-800">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 pb-12 border-b border-slate-800/80">
      <!-- Brand & Tagline -->
      <div class="lg:col-span-4">
        <a href="/" class="inline-flex items-center mb-4 group cursor-pointer" aria-label="Sistemagis Home">
          <SistemagisLogo theme="white" idPrefix="footer-logo" class="h-8 w-auto block" />
        </a>

        <p class="text-white font-semibold text-sm mb-2">
          Bereskan Solusi. Bikin Magis.
        </p>

        <p class="text-slate-400 text-xs sm:text-sm leading-relaxed max-w-sm mb-6">
          Digital product & solution studio yang membangun produk digital mandiri dan solusi teknologi kustom untuk membantu bisnis bekerja lebih sederhana, terhubung, dan siap berkembang.
        </p>

        <!-- Social Media Links -->
        <div class="flex items-center gap-3 text-xs font-semibold text-slate-400">
          <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">LinkedIn</a>
          <span>•</span>
          <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Instagram</a>
          <span>•</span>
          <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">GitHub</a>
          <span>•</span>
          <a href="mailto:hello@sistemagis.com" class="hover:text-white transition-colors">Email</a>
        </div>
      </div>

      <!-- Column 1: Products -->
      <div class="lg:col-span-3">
        <h4 class="text-white font-bold text-xs uppercase tracking-wider mb-4">Products</h4>
        <ul class="space-y-2.5 text-xs sm:text-sm">
          <li>
            <a href="https://www.weddingmagis.my.id/" target="_blank" rel="noopener noreferrer" class="hover:text-[#5194ea] transition-colors flex items-center gap-1.5">
              <span>KisahMagis</span>
              <span class="text-[10px] px-1.5 py-0.2 rounded bg-[#5194ea]/20 text-[#8bb4ea]">Wedding</span>
            </a>
          </li>
          <li>
            <a href="/#products" class="hover:text-[#5194ea] transition-colors">Lihat Semua Produk</a>
          </li>
        </ul>
      </div>

      <!-- Column 2: Solutions -->
      <div class="lg:col-span-3">
        <h4 class="text-white font-bold text-xs uppercase tracking-wider mb-4">Layanan & Solusi</h4>
        <ul class="space-y-2.5 text-xs sm:text-sm">
          <li><a href="/layanan#company-website" class="hover:text-[#5194ea] transition-colors">Company Website</a></li>
          <li><a href="/layanan#custom-system" class="hover:text-[#5194ea] transition-colors">Custom Business System</a></li>
          <li><a href="/layanan#saas-development" class="hover:text-[#5194ea] transition-colors">SaaS Development</a></li>
          <li><a href="/layanan#business-automation" class="hover:text-[#5194ea] transition-colors">Business Automation</a></li>
          <li><a href="/layanan#ai-solutions" class="hover:text-[#5194ea] transition-colors">AI & Custom RAG</a></li>
          <li><a href="/layanan#api-integration" class="hover:text-[#5194ea] transition-colors">System & API Integration</a></li>
        </ul>
      </div>

      <!-- Column 3: Company -->
      <div class="lg:col-span-2">
        <h4 class="text-white font-bold text-xs uppercase tracking-wider mb-4">Studio</h4>
        <ul class="space-y-2.5 text-xs sm:text-sm">
          <li><a href="/tentang-kami" class="hover:text-white transition-colors">Tentang Kami</a></li>
          <li><a href="/layanan" class="hover:text-white transition-colors">Semua Layanan</a></li>
          <li><a href="/#works" class="hover:text-white transition-colors">Portofolio</a></li>
          <li><a href="/#why-magis" class="hover:text-white transition-colors">Why Magis?</a></li>
          <li><a href="/#how-we-work" class="hover:text-white transition-colors">How We Work</a></li>
          <li><a href="/#contact" class="hover:text-white transition-colors">Hubungi Studio</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>© {currentYear} Sistemagis. All rights reserved.</p>
      <div class="flex items-center gap-4 text-slate-400">
        <span>Bereskan Solusi. Bikin Magis.</span>
        <span>•</span>
        <span>Bandung, Indonesia</span>
      </div>
    </div>
  </div>
</footer>

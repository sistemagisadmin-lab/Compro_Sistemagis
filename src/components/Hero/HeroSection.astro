---
import ShapeGrid from '../common/ShapeGrid.astro';
import iconGradient from '../../images/icon sistemagis gradient.png';
---

<section
  id="header"
  class="relative w-full min-h-[94vh] sm:min-h-screen flex flex-col justify-between pt-16 pb-16 sm:pb-24 lg:pb-28 overflow-hidden bg-white"
>
  <!-- Background Shape Grid -->
  <ShapeGrid interactive={true} />

  <!-- Background Ambient Glows with brand palette (#5194EA -> #8B5CF6) -->
  <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[700px] h-[400px] bg-gradient-to-tr from-[#5194ea]/20 via-[#8b5cf6]/20 to-transparent blur-3xl pointer-events-none -z-0"></div>
  <div class="absolute bottom-10 right-10 w-[500px] h-[350px] bg-gradient-to-br from-[#8b5cf6]/15 via-[#5194ea]/15 to-transparent blur-3xl pointer-events-none -z-0"></div>
  <div class="absolute top-1/3 left-10 w-[350px] h-[250px] bg-gradient-to-br from-[#d4af57]/10 via-transparent to-transparent blur-3xl pointer-events-none -z-0"></div>

  <!-- Top spacing for fixed navbar -->
  <div class="h-10 sm:h-16 w-full"></div>

  <!-- Hero Content Container -->
  <div class="relative z-20 mx-auto w-full max-w-6xl px-6 sm:px-10 lg:px-12 my-auto">
    <!-- Brand / Status Pill -->
    <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full glass-card border border-[#5194ea]/30 shadow-sm mb-6 sm:mb-8 animate-fade-in">
      <span class="flex h-2.5 w-2.5 relative">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#8b5cf6] opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-gradient-to-r from-[#5194ea] to-[#8b5cf6]"></span>
      </span>
      <span class="text-xs font-bold uppercase tracking-widest text-slate-700">
        Digital Product & Solution Studio
      </span>
      <span class="text-slate-300">|</span>
      <span class="text-xs font-semibold text-[#8b5cf6]">
        Bereskan Solusi. Bikin Magis.
      </span>
    </div>

    <!-- Main Title: "We Make Digital Solutions Feel Magis." -->
    <h1 class="text-4xl sm:text-6xl md:text-7xl lg:text-[5.4rem] font-black tracking-tighter text-[#0f172a] leading-[1.02] max-w-5xl">
      We Make
      <span class="relative inline-block">
        <span class="relative z-10 text-transparent bg-clip-text bg-gradient-to-r from-[#5194ea] via-[#7367f0] to-[#8b5cf6]">
          Digital Solutions
        </span>
        <span
          class="absolute inset-x-0 bottom-1 sm:bottom-2.5 h-3 sm:h-4 bg-gradient-to-r from-[#5194ea]/30 via-[#8b5cf6]/35 to-transparent -rotate-1 rounded-sm -z-0"
        ></span>
      </span>
      <br class="hidden sm:block" />
      Feel Magis<span class="text-[#8b5cf6]">.</span>
    </h1>

    <!-- Subtitle -->
    <p class="mt-6 sm:mt-8 text-lg sm:text-xl md:text-2xl text-slate-600 max-w-3xl font-medium leading-relaxed">
      Sistemagis membangun produk dan solusi digital yang membantu bisnis bekerja lebih sederhana, terhubung, dan siap berkembang. Dari masalah yang rumit menjadi hasil yang beres.
    </p>

    <!-- CTAs -->
    <div class="mt-8 sm:mt-10 flex flex-wrap items-center gap-4">
      <a
        href="#contact"
        class="inline-flex items-center justify-center gap-2.5 px-7 py-3.5 rounded-xl text-white font-bold text-sm bg-gradient-to-r from-[#5194ea] to-[#8b5cf6] hover:from-[#4185de] hover:to-[#784ce4] shadow-xl shadow-[#8b5cf6]/20 transition-all duration-200 hover:-translate-y-0.5"
      >
        <span>Mulai Proyek (Start a Project)</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>

      <a
        href="#products"
        class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl glass-card hover:bg-slate-50 text-slate-700 hover:text-[#0f172a] font-semibold text-sm border border-slate-300/80 shadow-sm transition-all duration-200 hover:-translate-y-0.5"
      >
        <span>Jelajahi Produk Kami</span>
        <svg class="w-4 h-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3" />
        </svg>
      </a>
    </div>

    <!-- Dual Business Pillar Quick Glance (Products & Solutions) -->
    <div class="mt-14 sm:mt-16 pt-8 border-t border-slate-200/80 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-5xl">
      <div class="flex items-start gap-3">
        <div class="w-9 h-9 rounded-xl bg-[#5194ea]/10 flex items-center justify-center text-[#5194ea] shrink-0 mt-0.5 font-bold">
          01
        </div>
        <div>
          <div class="text-base font-bold text-[#0f172a] tracking-tight">Digital Products</div>
          <div class="text-xs text-slate-500 font-medium mt-0.5">KisahMagis · Photobooth · SistemKost</div>
        </div>
      </div>

      <div class="flex items-start gap-3">
        <div class="w-9 h-9 rounded-xl bg-[#8b5cf6]/10 flex items-center justify-center text-[#8b5cf6] shrink-0 mt-0.5 font-bold">
          02
        </div>
        <div>
          <div class="text-base font-bold text-[#0f172a] tracking-tight">Client Solutions</div>
          <div class="text-xs text-slate-500 font-medium mt-0.5">Custom System · SaaS · Automation · Web</div>
        </div>
      </div>

      <div class="flex items-start gap-3">
        <div class="w-9 h-9 rounded-xl bg-[#0f172a]/10 flex items-center justify-center text-[#0f172a] shrink-0 mt-0.5 font-bold">
          03
        </div>
        <div>
          <div class="text-base font-bold text-[#0f172a] tracking-tight">Janji "Beres"</div>
          <div class="text-xs text-slate-500 font-medium mt-0.5">Masalah dipahami, proses dirapikan</div>
        </div>
      </div>

      <div class="flex items-start gap-3">
        <div class="w-9 h-9 rounded-xl bg-[#d4af57]/15 flex items-center justify-center text-[#b89035] shrink-0 mt-0.5 font-bold">
          04
        </div>
        <div>
          <div class="text-base font-bold text-[#0f172a] tracking-tight">Sentuhan "Magis"</div>
          <div class="text-xs text-slate-500 font-medium mt-0.5">Teknologi rumit terasa sederhana</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Scroll Hint Indicator -->
  <div class="relative z-10 mx-auto mt-8 flex flex-col items-center pointer-events-none opacity-70 hover:opacity-100 transition-opacity">
    <span class="text-xs font-semibold tracking-wider text-slate-400 uppercase">Scroll untuk eksplorasi</span>
    <div class="w-5 h-8 mt-2 rounded-full border-2 border-slate-300 flex items-start justify-center p-1">
      <div class="w-1 h-2 bg-gradient-to-b from-[#5194ea] to-[#8b5cf6] rounded-full animate-bounce"></div>
    </div>
  </div>
</section>

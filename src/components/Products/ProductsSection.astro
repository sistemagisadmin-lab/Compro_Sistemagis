---
import iconKisahmagis from '../../images/Icon kisahmagis.png';
import iconGradient from '../../images/icon sistemagis gradient.png';

const products = [
  {
    id: "kisahmagis",
    title: "KisahMagis",
    category: "Digital Wedding Experience",
    badge: "Active Ecosystem",
    badgeColor: "bg-[#4379bf]/10 text-[#4379bf] border-[#4379bf]/30",
    desc: "Digital invitation, wedding planner, RSVP, dan digital guest book dalam satu platform terintegrasi. Menghadirkan momen sakral pernikahan dengan sentuhan magis, elegan, dan teratur.",
    iconImg: iconKisahmagis.src,
    features: [
      "Undangan digital premium dengan audio & animasi fluid",
      "Sistem RSVP realtime & buku tamu (QR Check-in)",
      "Manajemen meja, amplop digital & ucapan selamat",
      "Fitur wedding planning, rundown & budget tracker"
    ],
    ctaText: "Explore KisahMagis →",
    ctaHref: "https://kisahmagis.com",
    external: true,
  },
  {
    id: "photobooth",
    title: "MagisPhotobooth",
    category: "Digital Event Experience",
    badge: "Event Tech",
    badgeColor: "bg-[#4379bf]/10 text-[#4379bf] border-[#4379bf]/30",
    desc: "Platform photobooth modern dan interaktif untuk event pesta, pernikahan, dan aktivasi brand korporat. Memberikan pengalaman visual instan yang langsung dapat diunduh para tamu.",
    iconSvg: `<path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z" /><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zM18.75 10.5h.008v.008h-.008V10.5z" />`,
    features: [
      "Custom dynamic frame & branding watermark sponsorship",
      "Live Cloud Gallery & instant QR code download",
      "Dukungan multi-device & high-resolution camera",
      "Koleksi filter, boomerangs & custom stickers"
    ],
    ctaText: "Pelajari MagisPhotobooth →",
    ctaHref: "#contact",
    external: false,
  },
  {
    id: "sistemkost",
    title: "SistemKost",
    category: "Property Management SaaS",
    badge: "SaaS Platform",
    badgeColor: "bg-[#0f172a]/10 text-[#0f172a] border-[#0f172a]/20",
    desc: "Sistem cerdas all-in-one untuk membantu pemilik kos mengelola kamar, data penghuni, penagihan sewa otomatis, dan pembukuan operasional secara tertib dan transparan.",
    iconSvg: `<path stroke-linecap="round" stroke-linejoin="round" d="M8.25 21v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21m0 0h4.5V3.545M12.75 21h7.5V10.75M2.25 21h1.5m18 0h-18M2.25 9l4.5-1.636M18.75 3l-1.5.545m0 6.205l3 1m1.5.5l-1.5-.5M6.75 7.364V3h-3v6" />`,
    features: [
      "Notifikasi tagihan sewa otomatis via WhatsApp & Email",
      "Payment gateway otomatis tanpa rekonsiliasi manual",
      "Dashboard okupansi kamar & pembukuan laba-rugi",
      "Dukungan multi-properti untuk pengelola kos profesional"
    ],
    ctaText: "Pelajari SistemKost →",
    ctaHref: "#contact",
    external: false,
  },
];
---

<section id="products" class="relative w-full py-24 sm:py-32 px-6 sm:px-10 lg:px-12 bg-white">
  <div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="max-w-3xl mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#4379bf]/10 text-[#4379bf] border border-[#4379bf]/30 text-xs font-bold uppercase tracking-wider mb-4">
        Sistemagis Products
      </div>
      <h2 class="text-3xl sm:text-5xl font-black text-[#0f172a] tracking-tight leading-tight">
        Built by Sistemagis
      </h2>
      <p class="mt-4 text-slate-600 text-base sm:text-xl font-medium leading-relaxed">
        Produk digital mandiri yang kami rancang dan kembangkan untuk menyelesaikan kebutuhan nyata dengan standar rekayasa tertinggi.
      </p>
    </div>

    <!-- Products Showcase Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        products.map((item) => (
          <div class="p-8 rounded-3xl bg-slate-50/80 border border-slate-200/90 hover:border-[#4379bf]/40 hover:bg-white transition-all duration-300 group hover:shadow-xl flex flex-col justify-between">
            <div>
              <!-- Top bar: Category badge & Icon -->
              <div class="flex items-center justify-between mb-6">
                <span class={`inline-flex items-center px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border ${item.badgeColor}`}>
                  {item.badge}
                </span>

                <div class="w-12 h-12 rounded-2xl bg-white border border-slate-200 shadow-sm flex items-center justify-center p-2 group-hover:border-[#4379bf]/30 group-hover:scale-105 transition-all">
                  {item.iconImg ? (
                    <img src={item.iconImg} alt={item.title} class="w-full h-full object-contain" />
                  ) : (
                    <div class="w-6 h-6 text-[#4379bf] group-hover:text-[#3664a0] transition-colors">
                      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" set:html={item.iconSvg} />
                    </div>
                  )}
                </div>
              </div>

              <!-- Title & Category -->
              <div class="mb-3">
                <h3 class="text-2xl font-black text-[#0f172a] tracking-tight group-hover:text-[#4379bf] transition-colors">
                  {item.title}
                </h3>
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">
                  {item.category}
                </span>
              </div>

              <p class="text-slate-600 text-sm leading-relaxed mt-3">
                {item.desc}
              </p>

              <!-- Feature bullet points -->
              <div class="mt-6 space-y-2.5">
                {item.features.map((feat) => (
                  <div class="flex items-start gap-2 text-xs font-medium text-slate-700">
                    <svg class="w-4 h-4 text-[#4379bf] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                    </svg>
                    <span>{feat}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- CTA button -->
            <div class="mt-8 pt-6 border-t border-slate-200/80">
              <a
                href={item.ctaHref}
                target={item.external ? "_blank" : "_self"}
                rel={item.external ? "noopener noreferrer" : ""}
                class="inline-flex items-center gap-2 text-sm font-bold text-[#4379bf] hover:text-[#3664a0] transition-colors"
              >
                <span>{item.ctaText}</span>
              </a>
            </div>
          </div>
        ))
      }

      <!-- Card 4: More Magis is Coming -->
      <div class="p-8 rounded-3xl bg-[#0f172a] text-white border border-[#4379bf]/30 relative overflow-hidden flex flex-col justify-between shadow-xl md:col-span-2 lg:col-span-3">
        <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-8">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#4379bf]/20 border border-[#4379bf]/40 text-white text-xs font-bold uppercase tracking-wider mb-3">
              <span class="w-2 h-2 rounded-full bg-[#4379bf] animate-ping"></span>
              Research & Incubation Lab
            </div>
            <h3 class="text-2xl sm:text-3xl font-black tracking-tight text-white">
              More Magis is Coming.
            </h3>
            <p class="mt-3 text-slate-300 text-sm sm:text-base leading-relaxed max-w-2xl">
              Kami secara konsisten mengeksplorasi ide-ide baru, prototipe SaaS, dan alat otomatisasi cerdas. Memiliki gagasan produk digital yang ingin divalidasi dan dikembangkan bersama studio kami?
            </p>
          </div>

          <div class="lg:col-span-4 flex lg:justify-end">
            <a
              href="#contact"
              class="px-6 py-3.5 rounded-xl bg-[#4379bf] hover:bg-[#3664a0] text-white font-bold text-sm shadow-md transition-all hover:scale-105 inline-flex items-center gap-2"
            >
              <span>Diskusikan Ide Produk</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

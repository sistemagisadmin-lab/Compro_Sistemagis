---
import iconKisahmagis from '../../images/Icon kisahmagis.png';
import previewWedding from '../../images/weddingmagis-preview.png';
---

<section id="products" class="relative w-full py-24 sm:py-32 px-6 sm:px-10 lg:px-12 bg-white">
  <div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="max-w-3xl mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#5194ea]/10 text-[#5194ea] border border-[#5194ea]/30 text-xs font-bold uppercase tracking-wider mb-4">
        Sistemagis Products
      </div>
      <h2 class="text-3xl sm:text-5xl font-black text-[#0f172a] tracking-tight leading-tight">
        Built by Sistemagis
      </h2>
      <p class="mt-4 text-slate-600 text-base sm:text-xl font-medium leading-relaxed">
        Produk digital mandiri yang kami rancang dan kembangkan untuk menyelesaikan kebutuhan nyata dengan standar rekayasa tertinggi.
      </p>
    </div>

    <!-- Featured Product: KisahMagis Wedding Platform -->
    <div class="p-8 sm:p-12 rounded-3xl bg-slate-50/90 border border-slate-200/90 hover:border-[#5194ea]/40 transition-all duration-300 group shadow-lg hover:shadow-2xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Left content -->
        <div class="lg:col-span-6 flex flex-col justify-between">
          <div>
            <!-- Category badge & Icon row -->
            <div class="flex items-center gap-4 mb-6">
              <div class="w-14 h-14 rounded-2xl bg-white border border-slate-200 shadow-sm flex items-center justify-center p-2.5 group-hover:border-[#5194ea]/30 group-hover:scale-105 transition-all">
                <img src={iconKisahmagis.src} alt="KisahMagis" class="w-full h-full object-contain" />
              </div>
              <div>
                <span class="inline-flex items-center px-3 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider bg-[#5194ea]/10 text-[#5194ea] border border-[#5194ea]/30">
                  Active Ecosystem
                </span>
                <h3 class="text-2xl sm:text-4xl font-black text-[#0f172a] tracking-tight group-hover:text-[#5194ea] transition-colors mt-1">
                  KisahMagis
                </h3>
              </div>
            </div>

            <p class="text-xs sm:text-sm font-semibold text-slate-500 uppercase tracking-wider mb-3">
              Digital Wedding Experience & Invitation Platform
            </p>

            <p class="text-slate-600 text-base leading-relaxed mb-6">
              Platform all-in-one undangan pernikahan digital interaktif, wedding planner, RSVP realtime, buku tamu cerdas (QR Check-in), dan amplop digital dalam satu platform terintegrasi. Menghadirkan momen sakral pernikahan dengan sentuhan magis dan teratur.
            </p>

            <!-- Feature bullet points -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 mb-8">
              <div class="flex items-start gap-2.5 text-sm font-medium text-slate-700">
                <svg class="w-5 h-5 text-[#5194ea] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
                <span>Undangan digital audio & fluid animation</span>
              </div>
              <div class="flex items-start gap-2.5 text-sm font-medium text-slate-700">
                <svg class="w-5 h-5 text-[#5194ea] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
                <span>Sistem RSVP realtime & QR Check-in</span>
              </div>
              <div class="flex items-start gap-2.5 text-sm font-medium text-slate-700">
                <svg class="w-5 h-5 text-[#5194ea] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
                <span>Manajemen meja & amplop digital QRIS</span>
              </div>
              <div class="flex items-start gap-2.5 text-sm font-medium text-slate-700">
                <svg class="w-5 h-5 text-[#5194ea] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
                <span>Wedding planner & budget tracker</span>
              </div>
            </div>
          </div>

          <!-- CTA buttons -->
          <div class="pt-4 border-t border-slate-200/80 flex flex-wrap items-center gap-4">
            <a
              href="https://www.weddingmagis.my.id/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2.5 px-6 py-3.5 rounded-xl bg-[#5194ea] hover:bg-[#3f7cd0] text-white font-bold text-sm shadow-md shadow-[#5194ea]/20 transition-all hover:scale-105"
            >
              <span>Explore KisahMagis</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>

            <a
              href="https://www.weddingmagis.my.id/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-sm font-semibold text-slate-600 hover:text-[#5194ea] transition-colors"
            >
              <span>weddingmagis.my.id</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Right: Live Web Preview Image -->
        <div class="lg:col-span-6">
          <a
            href="https://www.weddingmagis.my.id/"
            target="_blank"
            rel="noopener noreferrer"
            class="block relative group/preview rounded-2xl overflow-hidden border border-slate-200/90 bg-white shadow-xl hover:shadow-2xl transition-all duration-300 hover:border-[#5194ea]/50"
          >
            <!-- Preview Image Screen -->
            <div class="relative overflow-hidden bg-slate-100 aspect-16/10">
              <img
                src={previewWedding.src}
                alt="Wedding Magis Live Preview"
                class="w-full h-full object-cover object-top transition-transform duration-500 group-hover/preview:scale-105"
                loading="lazy"
              />

              <!-- Hover overlay badge -->
              <div class="absolute inset-0 bg-[#0f172a]/40 opacity-0 group-hover/preview:opacity-100 transition-opacity duration-300 flex items-center justify-center backdrop-blur-[2px]">
                <div class="px-5 py-2.5 rounded-xl bg-[#5194ea] text-white font-bold text-xs sm:text-sm shadow-xl flex items-center gap-2 transform translate-y-2 group-hover/preview:translate-y-0 transition-transform">
                  <span>Buka Live Website</span>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                  </svg>
                </div>
              </div>
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

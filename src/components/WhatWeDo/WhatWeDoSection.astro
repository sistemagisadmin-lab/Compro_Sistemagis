---
const capabilities = [
  {
    num: "01",
    key: "Build",
    title: "Membangun Fondasi Digital",
    desc: "Mulai dari high-converting company website, web application berskala besar, hingga arsitektur produk SaaS siap monetisasi.",
    items: ["Modern Company Website", "Scalable Web Application", "Full SaaS Engineering", "Internal Business Tools"],
    gradient: "from-[#5194ea] to-[#3b82f6]",
    badgeBg: "bg-[#5194ea]/10 text-[#5194ea] border-[#5194ea]/20",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M14.25 9.75L16.5 12l-2.25 2.25m-4.5 0L7.5 12l2.25-2.25M6 20.25h12A2.25 2.25 0 0020.25 18V6A2.25 2.25 0 0018 3.75H6A2.25 2.25 0 003.75 6v12A2.25 2.25 0 006 20.25z" />`
  },
  {
    num: "02",
    key: "Connect",
    title: "Integrasi & Automasi Proses",
    desc: "Menghubungkan aplikasi, database, webhook, dan API pihak ketiga. Mengeliminasi pekerjaan manual berulang agar tim Anda fokus pada pertumbuhan.",
    items: ["RESTful & GraphQL APIs", "Workflow Automation (n8n/Webhooks)", "Payment Gateway Integration", "Multi-System Sync"],
    gradient: "from-[#8b5cf6] to-[#6d28d9]",
    badgeBg: "bg-[#8b5cf6]/10 text-[#8b5cf6] border-[#8b5cf6]/20",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" />`
  },
  {
    num: "03",
    key: "Intelligence",
    title: "Kecerdasan Buatan & Data",
    desc: "Menerapkan AI praktis, Retrieval-Augmented Generation (RAG) atas data bisnis internal, dan sistem rekomendasi yang langsung bernilai nyata.",
    items: ["Custom AI Copilots & RAG", "Automated Document Parsing", "Data Analytics & Pipelines", "Intelligent Business Rules"],
    gradient: "from-[#d4af57] to-[#b45309]",
    badgeBg: "bg-[#d4af57]/15 text-[#b89035] border-[#d4af57]/30",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456z" />`
  },
  {
    num: "04",
    key: "Experience",
    title: "Pengalaman Digital Interaktif",
    desc: "Menciptakan antarmuka yang intuitif dan berkesan untuk konsumen, tamu event, maupun pengguna aplikasi dengan micro-interaction halus.",
    items: ["Digital Guestbook & RSVP", "Event Photobooth Platforms", "Intuitive UI/UX Flow", "Mobile-First Experiences"],
    gradient: "from-[#0f172a] to-[#334155]",
    badgeBg: "bg-[#0f172a]/10 text-[#0f172a] border-[#0f172a]/20",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M15.182 15.182a4.5 4.5 0 01-6.364 0M21 12a9 9 0 11-18 0 9 9 0 0118 0zM9.75 9.75c0 .414-.168.75-.375.75S9 10.164 9 9.75 9.168 9 9.375 9s.375.336.375.75zm-.375 0h.008v.015h-.008V9.75zm5.625 0c0 .414-.168.75-.375.75s-.375-.336-.375-.75.168-.75.375-.75.375.336.375.75zm-.375 0h.008v.015h-.008V9.75z" />`
  }
];
---

<section id="what-we-do" class="relative w-full py-20 sm:py-28 px-6 sm:px-10 lg:px-12 bg-slate-50 border-t border-slate-200/80">
  <div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="max-w-3xl mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#5194ea]/10 border border-[#5194ea]/25 text-[#5194ea] text-xs font-bold uppercase tracking-wider mb-4">
        What We Do
      </div>
      <h2 class="text-3xl sm:text-5xl font-black text-[#0f172a] tracking-tight leading-tight">
        Dari masalah yang rumit menjadi solusi yang beres.
      </h2>
      <p class="mt-4 text-slate-600 text-base sm:text-xl font-medium leading-relaxed">
        <span class="text-[#0f172a] font-semibold">Technology should solve problems, not create more of them.</span> Kami merancang dan membangun ekosistem digital terpadu melalui empat pilar kemampuan utama.
      </p>
    </div>

    <!-- 4 Capability Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
      {
        capabilities.map((cap) => (
          <div class="p-8 rounded-3xl bg-white border border-slate-200/90 hover:border-[#8b5cf6]/40 transition-all duration-300 group hover:shadow-xl hover:shadow-[#8b5cf6]/5 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-6">
                <span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border ${cap.badgeBg}`}>
                  {cap.key}
                </span>
                <span class="text-3xl font-black text-slate-300 font-mono group-hover:text-[#8b5cf6] transition-colors">
                  {cap.num}
                </span>
              </div>

              <div class="flex items-center gap-3.5 mb-3">
                <div class="w-10 h-10 rounded-xl bg-slate-100 flex items-center justify-center text-slate-700 group-hover:bg-gradient-to-br group-hover:from-[#5194ea] group-hover:to-[#8b5cf6] group-hover:text-white transition-all">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" set:html={cap.icon} />
                </div>
                <h3 class="text-xl sm:text-2xl font-bold text-[#0f172a] tracking-tight">
                  {cap.title}
                </h3>
              </div>

              <p class="text-slate-600 text-sm sm:text-base leading-relaxed mt-2">
                {cap.desc}
              </p>
            </div>

            <div class="mt-8 pt-6 border-t border-slate-100">
              <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block mb-3">Cakupan Solusi:</span>
              <div class="flex flex-wrap gap-2">
                {cap.items.map((item) => (
                  <span class="px-2.5 py-1 rounded-lg bg-slate-50 border border-slate-200/70 text-slate-700 text-xs font-medium">
                    {item}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

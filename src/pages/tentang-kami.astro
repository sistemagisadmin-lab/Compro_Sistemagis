---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar/Navbar.astro';
import Footer from '../components/Footer/Footer.astro';
import SignatureCTA from '../components/CTA/SignatureCTA.astro';

const coreValues = [
  {
    tag: 'FILOSOFI 01',
    title: 'MAGIS',
    subtitle: 'The Craft & Soul',
    description:
      'Magis bukan berarti sulap atau ilusi mistis, melainkan kemampuan mengubah kerumitan proses bisnis menjadi sesuatu yang terasa sangat sederhana, anggun, dan bernilai tinggi bagi penggunanya.',
    points: [
      'Curiosity — Terus mengeksplorasi teknologi mutakhir yang relevan.',
      'Creativity — Pendekatan segar untuk memecahkan problem rumit.',
      'Intelligence — Menggunakan tools secara tepat sasaran, bukan sekadar hype.',
      'Possibility — Membuka peluang baru dari kendala operasional yang ada.',
    ],
    bgGradient: 'from-blue-500/10 via-indigo-500/5 to-transparent',
    borderColor: 'border-blue-500/20',
    iconColor: 'text-[#5194ea]',
  },
  {
    tag: 'FILOSOFI 02',
    title: 'BERES',
    subtitle: 'The Standard of Delivery',
    description:
      'Bagi kami, delivery bukan sekadar "jadi", tapi tuntas sampai ke akarnya. Sistem yang kami bangun harus handal, aman, bersih dari technical debt yang tersembunyi, dan langsung siap dipakai menopang bisnis Anda.',
    points: [
      'Zero Technical Debt — Kode rapi, terdokumentasi, dan mudah dirawat.',
      'Data & Code Ownership — 100% hak cipta source code & data milik client.',
      'Production Ready — Melewati serangkaian pengujian fungsional dan keamanan.',
      'Peace of Mind — Garansi pemeliharaan dan support teknis pasca-peluncuran.',
    ],
    bgGradient: 'from-cyan-500/10 via-blue-500/5 to-transparent',
    borderColor: 'border-cyan-500/20',
    iconColor: 'text-cyan-400',
  },
];

const pillars = [
  {
    title: 'Sistemagis Products',
    badge: 'In-House Ventures',
    desc: 'Laboratorium produk digital mandiri yang kami rancang, bangun, dan operasikan sendiri. Menjadi arena pembuktian standar arsitektur dan pengalaman pengguna kami di pasar nyata.',
    items: ['KisahMagis (Platform Undangan & Planner Digital)', 'MagisPhotobooth (Interactive Event Experience)', 'SistemKost (Sistem Manajemen Properti Kost)'],
    accent: '#5194ea',
  },
  {
    title: 'Sistemagis Solutions',
    badge: 'Client Engineering',
    desc: 'Mitra rekayasa teknologi kustom bagi founder, pemilik bisnis, dan korporasi. Kami menerjemahkan tantangan bisnis menjadi software berkualitas tinggi yang siap diskalakan.',
    items: ['High-Performance Web Platforms', 'Enterprise Custom Business Systems', 'SaaS Architecture & Development', 'Workflow Automation & Custom AI / RAG'],
    accent: '#38bdf8',
  },
];

const techStack = [
  {
    category: 'Frontend & UI',
    techs: ['React', 'Next.js', 'Astro', 'TypeScript', 'Tailwind CSS', 'Vue.js'],
  },
  {
    category: 'Backend & Systems',
    techs: ['Node.js', 'NestJS', 'Laravel', 'Python', 'FastAPI', 'Go'],
  },
  {
    category: 'AI & Intelligence',
    techs: ['OpenAI / Anthropic API', 'Custom RAG', 'LangChain', 'Vector Embeddings', 'Ollama / Local LLM'],
  },
  {
    category: 'Databases & Cache',
    techs: ['PostgreSQL', 'MySQL', 'Redis', 'Supabase', 'Prisma ORM'],
  },
  {
    category: 'DevOps & Cloud',
    techs: ['Docker', 'Cloudflare', 'AWS / DigitalOcean', 'CI/CD Pipelines', 'Linux'],
  },
  {
    category: 'Design & Collaboration',
    techs: ['Figma', 'Postman', 'Git / GitHub', 'Linear', 'Notion'],
  },
];

const studioPrinciples = [
  {
    step: '01',
    title: 'Komunikasi Langsung dengan Engineer',
    desc: 'Tidak ada perantara sales atau account executive yang tidak mengerti kode. Anda berdiskusi langsung dengan tech lead dan software architect kami.',
  },
  {
    step: '02',
    title: 'Transparansi & Sprint Terukur',
    desc: 'Setiap progress dicatat dan diuji dalam milestone dua mingguan. Anda selalu tahu persis status pengembangan dan jadwal peluncuran.',
  },
  {
    step: '03',
    title: 'Kepemilikan Penuh (No Vendor Lock-in)',
    desc: 'Seluruh repository git, deployment script, dan hak milik intelektual diserahkan penuh kepada Anda tanpa ikatan lisensi tersembunyi.',
  },
  {
    step: '04',
    title: 'Dukungan & Garansi Pasca-Rilis',
    desc: 'Kami tidak pergi setelah website online. Kami mendampingi masa transisi, pelatihan tim Anda, dan memberikan garansi bug-free.',
  },
];
---

<Layout
  title="Tentang Kami — Sistemagis | Digital Product & Solution Studio"
  description="Mengenal lebih dekat Sistemagis: digital product & solution studio yang memegang teguh filosofi Magis (kesederhanaan solusi) dan Beres (standar tuntas deliverable)."
>
  <Navbar />

  <main class="relative min-h-screen bg-slate-50 text-slate-900 overflow-hidden pt-28 sm:pt-36">
    <!-- Ambient Background Lighting -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[550px] bg-gradient-to-b from-[#5194ea]/15 via-[#93c5fd]/10 to-transparent blur-3xl pointer-events-none -z-10"></div>
    <div class="absolute top-96 right-0 w-96 h-96 bg-indigo-500/10 blur-3xl pointer-events-none -z-10"></div>

    <!-- Section 1: Hero Header -->
    <section class="px-6 sm:px-10 lg:px-12 max-w-6xl mx-auto text-center pb-16 sm:pb-24">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#5194ea]/10 border border-[#5194ea]/25 text-[#2b6fc2] text-xs font-bold uppercase tracking-wider mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-[#5194ea]"></span>
        Tentang Sistemagis Studio
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-slate-900 max-w-4xl mx-auto leading-[1.15]">
        We believe technology should make things <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#2b6fc2] via-[#5194ea] to-indigo-500">better, not harder.</span>
      </h1>

      <p class="mt-6 text-base sm:text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed">
        Sistemagis adalah studio rekayasa produk digital dan solusi teknologi yang berbasis di Bandung, Indonesia. Kami lahir dari sebuah keyakinan sederhana: <strong>sistem digital terbaik adalah sistem yang menyelesaikan masalah nyata dengan anggun dan tuntas.</strong>
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-4 text-xs sm:text-sm font-semibold text-slate-600">
        <span class="inline-flex items-center gap-1.5 py-1.5 px-3 rounded-full bg-white shadow-sm border border-slate-200">
          <svg class="w-4 h-4 text-[#5194ea]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
          Dual-Engine Studio (Products & Solutions)
        </span>
        <span class="inline-flex items-center gap-1.5 py-1.5 px-3 rounded-full bg-white shadow-sm border border-slate-200">
          <svg class="w-4 h-4 text-[#5194ea]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
          100% Clean Code & Ownership
        </span>
        <span class="inline-flex items-center gap-1.5 py-1.5 px-3 rounded-full bg-white shadow-sm border border-slate-200">
          <svg class="w-4 h-4 text-[#5194ea]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
          Direct Engineering Collaboration
        </span>
      </div>
    </section>

    <!-- Section 2: Dua Pilar Filosofi (Magis & Beres) -->
    <section class="px-6 sm:px-10 lg:px-12 max-w-6xl mx-auto py-12 sm:py-20 border-t border-slate-200/80">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <h2 class="text-xs font-bold uppercase tracking-widest text-[#5194ea] mb-3">DNA & Core Philosophy</h2>
        <p class="text-2xl sm:text-4xl font-extrabold text-slate-900">
          Dua Prinsip yang Menggerakkan Setiap Baris Kode Kami
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {coreValues.map((val) => (
          <div class={`relative rounded-3xl p-8 sm:p-10 bg-white border ${val.borderColor} shadow-lg shadow-slate-200/50 flex flex-col justify-between overflow-hidden transition-transform duration-300 hover:-translate-y-1`}>
            <div class={`absolute top-0 right-0 w-64 h-64 bg-gradient-to-br ${val.bgGradient} rounded-full blur-2xl pointer-events-none`}></div>
            <div class="relative z-10">
              <span class="inline-block px-3 py-1 rounded-full text-[11px] font-extrabold tracking-wider bg-slate-100 text-slate-600 mb-4">
                {val.tag}
              </span>
              <h3 class="text-3xl sm:text-4xl font-black tracking-tight text-slate-900 flex items-baseline gap-3">
                <span>{val.title}</span>
                <span class="text-xs sm:text-sm font-semibold text-slate-500 uppercase tracking-widest">— {val.subtitle}</span>
              </h3>
              <p class="mt-4 text-sm sm:text-base text-slate-600 leading-relaxed">
                {val.description}
              </p>

              <div class="mt-6 pt-6 border-t border-slate-100 space-y-3">
                {val.points.map((point) => (
                  <div class="flex items-start gap-3 text-xs sm:text-sm text-slate-700">
                    <svg class={`w-4 h-4 mt-0.5 shrink-0 ${val.iconColor}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span>{point}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Section 3: Dual Engines (Products & Solutions) -->
    <section class="px-6 sm:px-10 lg:px-12 max-w-6xl mx-auto py-12 sm:py-20 border-t border-slate-200/80">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-5">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-200 text-slate-700 text-xs font-bold uppercase tracking-wider mb-4">
            Model Operasi Kami
          </div>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 leading-tight">
            Bukan Sekadar Software House Generik
          </h2>
          <p class="mt-4 text-sm sm:text-base text-slate-600 leading-relaxed">
            Kebanyakan agensi hanya mengerjakan pesanan lalu berpindah tanpa memahami dinamika produk jangka panjang. Sistemagis berbeda karena kami juga merawat dan menumbuhkan produk milik sendiri.
          </p>
          <div class="mt-6 p-4 rounded-2xl bg-blue-50/70 border border-blue-200/60 text-xs sm:text-sm text-blue-900 leading-relaxed">
            💡 <strong>Pembeda Nyata:</strong> Pengalaman mengelola infrastruktur 24/7 dan melayani ribuan pengguna akhir di produk kami diterapkan langsung saat membangun sistem bisnis klien.
          </div>
        </div>

        <div class="lg:col-span-7 space-y-6">
          {pillars.map((pillar) => (
            <div class="p-6 sm:p-8 rounded-3xl bg-white border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow">
              <div class="flex items-center justify-between mb-3">
                <h3 class="text-xl font-bold text-slate-900">{pillar.title}</h3>
                <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-[#5194ea]/10 text-[#2b6fc2]">{pillar.badge}</span>
              </div>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
                {pillar.desc}
              </p>
              <div class="flex flex-wrap gap-2">
                {pillar.items.map((item) => (
                  <span class="text-xs font-medium px-3 py-1.5 rounded-xl bg-slate-50 border border-slate-200 text-slate-700">
                    {item}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Section 4: Technology Stack Matrix -->
    <section class="px-6 sm:px-10 lg:px-12 max-w-6xl mx-auto py-12 sm:py-20 border-t border-slate-200/80">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <h2 class="text-xs font-bold uppercase tracking-widest text-[#5194ea] mb-3">Technology & Arsenal</h2>
        <p class="text-2xl sm:text-4xl font-extrabold text-slate-900">
          Teknologi Modern untuk Performa Tinggi & Skalabilitas
        </p>
        <p class="mt-3 text-sm text-slate-600">
          Kami memilih stack berbasis kestabilan, ekosistem aktif, dan kecepatan eksekusi.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {techStack.map((stack) => (
          <div class="p-6 rounded-3xl bg-white border border-slate-200 shadow-sm hover:border-[#5194ea]/40 transition-colors">
            <h3 class="text-base font-bold text-slate-900 mb-4 flex items-center justify-between">
              <span>{stack.category}</span>
              <span class="w-2 h-2 rounded-full bg-[#5194ea]"></span>
            </h3>
            <div class="flex flex-wrap gap-2">
              {stack.techs.map((t) => (
                <span class="text-xs font-medium px-3 py-1.5 rounded-lg bg-slate-50 hover:bg-blue-50 text-slate-700 hover:text-[#2b6fc2] border border-slate-200/80 transition-colors">
                  {t}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Section 5: Cara Kami Bekerja (Our Principles) -->
    <section class="px-6 sm:px-10 lg:px-12 max-w-6xl mx-auto py-12 sm:py-20 border-t border-slate-200/80">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <h2 class="text-xs font-bold uppercase tracking-widest text-[#5194ea] mb-3">Studio Standards</h2>
        <p class="text-2xl sm:text-4xl font-extrabold text-slate-900">
          Bagaimana Kolaborasi dengan Sistemagis Berjalan
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {studioPrinciples.map((item) => (
          <div class="p-6 sm:p-7 rounded-3xl bg-white border border-slate-200 shadow-sm relative overflow-hidden flex flex-col justify-between">
            <span class="text-3xl font-black text-slate-200/90 mb-4">{item.step}</span>
            <div>
              <h3 class="text-base font-bold text-slate-900 leading-snug mb-2">{item.title}</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Section 6: Signature CTA -->
    <SignatureCTA />
  </main>

  <Footer />
</Layout>
